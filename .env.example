# Copy to .env.dev for local development. server/db.ts and scripts/dev.mjs
# auto-load .env.dev from the repo root.

# Required: Forgejo admin token used by Cosheaf to create proxy users, repos,
# branch protection, and webhooks.
COSHEAF_FORGEJO_TOKEN=

# Required: shared webhook HMAC secret for Forgejo -> Cosheaf events.
COSHEAF_WEBHOOK_SECRET=dev-webhook-secret

# Optional defaults.
COSHEAF_DATA_DIR=./data
COSHEAF_PORT=3030
COSHEAF_FORGEJO_URL=http://127.0.0.1:3002
COSHEAF_FORGEJO_OWNER=cosheaf-admin
COSHEAF_WEBHOOK_URL=http://127.0.0.1:3030/api/v1/webhooks/forgejo
COSHEAF_SERVER_URL=http://localhost:3030
