# Copy to .env.dev for local development. server/db.ts and scripts/dev.mjs
# auto-load .env.dev from the repo root.
#
# Prerequisite: a Forgejo instance reachable at COSHEAF_FORGEJO_URL (default
# 127.0.0.1:3002). Mint the two tokens below from Forgejo:
# Settings -> Applications -> Generate New Token. The runtime token needs
# repo/issue/notification + write:user + write:organization scopes; the admin
# token must belong to a site-admin (used for provisioning/webhook paths).
# `pnpm preflight` checks that this file and Forgejo are ready before you start.

# Required: non-site-admin Forgejo runtime token.
COSHEAF_FORGEJO_TOKEN=

# Required: Forgejo site-admin token for provisioning/operator paths.
COSHEAF_FORGEJO_ADMIN_TOKEN=

# Required: shared webhook HMAC secret for Forgejo -> Cosheaf events.
COSHEAF_WEBHOOK_SECRET=dev-webhook-secret

# Optional defaults.
COSHEAF_DATA_DIR=./data
COSHEAF_PORT=3030
COSHEAF_FORGEJO_URL=http://127.0.0.1:3002
# Public SSH host users should clone from. Production normally sets this to
# gitea.lab. Defaults to the hostname from COSHEAF_FORGEJO_URL.
# COSHEAF_GIT_SSH_HOST=
COSHEAF_WEBHOOK_URL=http://127.0.0.1:3030/api/v1/webhooks/forgejo
COSHEAF_SERVER_URL=http://localhost:3030
# Optional local browser/test URLs. COSHEAF_WEB_URL is the page origin used by
# DevX/Playwright helpers; COSHEAF_API_URL overrides its /api/v1 derivation.
# COSHEAF_VITE_PORT controls the page-island Vite dev server. When
# COSHEAF_WEB_URL uses an http non-local host such as http://jupiter:3030,
# Vite assets default to the same host on this port; set COSHEAF_VITE_ORIGIN
# when that derived asset origin is wrong, or when COSHEAF_WEB_URL is https.
# COSHEAF_WEB_URL=http://localhost:3030
# COSHEAF_API_URL=http://localhost:3030/api/v1
COSHEAF_VITE_PORT=5173
# COSHEAF_VITE_ORIGIN=http://localhost:5173
# Canonical browser origin for CSRF checks and secure cookies when serving
# behind a reverse proxy. Example: https://cosheaf.lab
# COSHEAF_PUBLIC_ORIGIN=

# Optional: web self-service signup. "off" (default) makes the /register page
# 404; "open" lets anyone create an account, which cosheaf provisions through
# the site-admin token (the only request-path use of COSHEAF_FORGEJO_ADMIN_TOKEN).
COSHEAF_REGISTRATION_MODE=off

# Optional: number of trusted reverse-proxy hops in front of cosheaf. This
# selects the trusted entries from X-Forwarded-For/Proto/Host for registration
# rate limiting, CSRF origin checks, and secure cookies. 0
# (default) = no trusted proxy. Behind the lab's single Caddy, set this to 1
# and set COSHEAF_PUBLIC_ORIGIN above; startup rejects trusted proxy mode
# without a configured public origin.
COSHEAF_TRUSTED_PROXY_HOPS=0

# Optional: set to any value to turn on the hono request access log plus SSE
# fan-out tracing. Backend 5xx/network failures and unhandled errors always log
# (with an X-Request-Id correlation id); this only adds the per-request firehose.
# COSHEAF_REQUEST_LOG=1
