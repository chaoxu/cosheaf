{
  "name": "cosheaf",
  "version": "0.1.0",
  "description": "Forgejo-native knowledge base for Coflat markdown",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaoxu/cosheaf.git"
  },
  "homepage": "https://github.com/chaoxu/cosheaf#readme",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev.mjs",
    "setup:deps": "node scripts/check-coflat-ref.mjs && pnpm --dir ../coflat install --frozen-lockfile && pnpm --dir ../coflat build",
    "bump:coflat": "node scripts/bump-coflat.mjs",
    "refresh:coflat": "node scripts/refresh-coflat.mjs",
    "coflat:status": "node scripts/coflat-status.mjs",
    "verify:cogirth-outline": "node scripts/verify-cogirth-outline.mjs",
    "dev:worktree": "node scripts/dev-worktree.mjs",
    "dev:login-state": "node scripts/web-login-state.mjs",
    "devx": "node scripts/devx.mjs ready",
    "devx:ready": "node scripts/devx.mjs ready",
    "devx:what-to-run": "node scripts/devx-what-to-run.mjs",
    "devx:verify-route": "node scripts/web-route-check.mjs",
    "setup:dev": "tsx server/cli.ts seed --user chao --password Cosheaf123! --workspace chao/flushing-coin --workspace-name \"Flushing Coin\" --default-md-format coflat",
    "setup:dev:review": "pnpm setup:dev && tsx server/cli.ts user create test-vera Cosheaf123! && tsx server/cli.ts user create test-meri Cosheaf123! && tsx server/cli.ts workspace member chao/flushing-coin test-vera write && tsx server/cli.ts workspace member chao/flushing-coin test-meri write",
    "server": "tsx watch server/index.ts",
    "server:start": "tsx server/index.ts",
    "cli": "tsx server/cli.ts",
    "build": "vite build",
    "build:server": "rm -rf dist-server && tsc -p server/tsconfig.build.json && mkdir -p dist-server/server && cp server/schema.sql dist-server/server/schema.sql && node scripts/check-server-build-output.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "node scripts/check-coflat-ref.mjs && tsc --noEmit",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
    "typecheck:tooling": "tsc --noEmit -p tsconfig.tooling.json",
    "typecheck:watch": "tsc --noEmit --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:fast": "pnpm typecheck && pnpm test",
    "dev:fresh": "rm -rf node_modules/.vite node_modules/.vite-temp && pnpm dev:all",
    "lint": "pnpm check:lint",
    "lint:errors": "node scripts/check-bare-catch.mjs",
    "lint:boundaries": "node scripts/check-layer-boundaries.mjs",
    "lint:api-contract": "node scripts/check-api-contract.mjs",
    "lint:fix": "biome lint . --write",
    "knip": "knip",
    "check:types": "pnpm typecheck && pnpm typecheck:server && pnpm typecheck:tooling",
    "check:lint": "pnpm lint:errors && pnpm lint:boundaries && pnpm lint:api-contract && biome lint .",
    "check:staged-lint": "biome lint",
    "check:unused": "pnpm knip",
    "check:unit": "vitest run",
    "check:pnpm-version": "node scripts/check-package-manager-version.mjs",
    "check:static": "pnpm check:lint && pnpm check:types && pnpm check:unused",
    "check": "pnpm check:local",
    "check:local:direct": "pnpm check:static && pnpm test && pnpm build && pnpm build:server",
    "check:local": "node scripts/pinned-check.mjs",
    "check:pinned": "node scripts/pinned-check.mjs",
    "check:web:fast": "pnpm check:types && pnpm exec vitest run server/routes/web-files.test.ts server/routes/web-shell.test.ts server/app.test.ts && pnpm build && pnpm build:server",
    "preflight": "node scripts/doctor.mjs",
    "check:pre-push": "node scripts/pre-push-check.mjs",
    "check:merge": "pnpm check:static && pnpm check:unit",
    "issue": "node scripts/issue.mjs",
    "devx:pending": "node scripts/devx-pending.mjs",
    "devx:review-prompt": "node scripts/devx-review-prompt.mjs",
    "merge-task": "node scripts/merge-task.mjs",
    "smoke": "playwright test --config playwright.smoke.config.ts --grep @smoke-basic",
    "smoke:list": "node scripts/smoke-list.mjs",
    "smoke:repo-home": "playwright test --config playwright.smoke.config.ts --grep @smoke-repo-home",
    "smoke:issues": "playwright test --config playwright.smoke.config.ts --grep @smoke-issues",
    "smoke:rendering": "playwright test --config playwright.smoke.config.ts --grep @smoke-rendering",
    "smoke:reader-parity": "playwright test --config playwright.smoke.config.ts --grep @smoke-reader-parity",
    "smoke:edit": "playwright test --config playwright.smoke.config.ts --grep @smoke-edit",
    "smoke:math": "playwright test --config playwright.smoke.config.ts --grep @smoke-math",
    "smoke:api": "node scripts/api-smoke.mjs",
    "prod:status": "node scripts/coflat-status.mjs --prod",
    "staging:deploy": "node scripts/staging-release.mjs deploy",
    "staging:verify": "node scripts/staging-release.mjs verify",
    "staging:e2e": "node scripts/staging-e2e.mjs",
    "staging:refs": "node scripts/staging-reference-smoke.mjs",
    "staging:gate": "node scripts/staging-release.mjs gate",
    "prod:release": "node scripts/prod-release.mjs release",
    "prod:verify": "node scripts/prod-release.mjs verify",
    "prod:repo-check": "node scripts/prod-release.mjs repo-check",
    "prod:build-check": "node scripts/prod-release.mjs build-check",
    "prod:e2e": "node scripts/prod-e2e.mjs",
    "pluto:release": "node scripts/prod-release.mjs release",
    "pluto:verify": "node scripts/prod-release.mjs verify",
    "pluto:repo-check": "node scripts/prod-release.mjs repo-check",
    "pluto:e2e": "node scripts/prod-e2e.mjs",
    "jupiter:e2e": "node scripts/jupiter-e2e.mjs",
    "test:e2e": "node scripts/playwright-devx.mjs",
    "check:e2e": "node scripts/playwright-devx.mjs",
    "check:web": "node scripts/playwright-devx.mjs tests/e2e/web-pages.spec.ts",
    "check:web:settings": "node scripts/playwright-devx.mjs tests/e2e/web-settings.spec.ts",
    "check:stability": "pnpm test && pnpm check:e2e",
    "clean": "rm -rf dist dist-server test-results playwright-report",
    "prepare": "lefthook install",
    "setup:dev:manual": "pnpm setup:dev:review && tsx server/cli.ts user create test-bob Cosheaf123! && tsx server/cli.ts workspace member chao/flushing-coin test-bob read && tsx server/cli.ts seed --user chao --password Cosheaf123! --workspace chao/passthrough-demo --workspace-name \"Passthrough Demo\" --default-md-format forgejo-passthrough && tsx server/cli.ts workspace member chao/passthrough-demo test-vera write && tsx server/cli.ts workspace member chao/passthrough-demo test-meri write && tsx server/cli.ts workspace member chao/passthrough-demo test-bob read && node scripts/manual-seed-checklist.mjs"
  },
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "lefthook"
    ]
  },
  "dependencies": {
    "@chaoxu/coflat": "file:../coflat",
    "@citation-js/core": "^0.7.21",
    "@citation-js/plugin-bibtex": "^0.7.21",
    "@citation-js/plugin-csl": "^0.7.22",
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.2",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.40.0",
    "@hono/node-server": "^2.0.2",
    "@lezer/common": "^1.5.1",
    "@lezer/highlight": "^1.2.3",
    "better-sqlite3": "^12.9.0",
    "commander": "^14.0.3",
    "dompurify": "^3.4.3",
    "hono": "^4.12.18",
    "katex": "^0.16.38",
    "lucide": "^1.18.0",
    "parse-diff": "^0.12.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "knip": "^6.12.2",
    "lefthook": "^2.1.4",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.9",
    "vitest": "^4.1.0"
  }
}
