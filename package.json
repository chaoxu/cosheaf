{
  "name": "cosheaf",
  "version": "0.1.0",
  "description": "Notion-like multi-user knowledge base for mathematical writing",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev.mjs",
    "dev:worktree": "node scripts/dev-worktree.mjs",
    "dev:login-state": "node scripts/web-login-state.mjs",
    "setup:dev": "tsx server/cli.ts seed --user chao --password Cosheaf123! --workspace flushing-coin --workspace-name \"Flushing Coin\" --default-md-format coflat",
    "setup:dev:review": "pnpm setup:dev && tsx server/cli.ts user create vera Cosheaf123! && tsx server/cli.ts user create meri Cosheaf123! && tsx server/cli.ts workspace member flushing-coin vera write && tsx server/cli.ts workspace member flushing-coin meri write",
    "server": "tsx watch server/index.ts",
    "server:start": "tsx server/index.ts",
    "cli": "tsx server/cli.ts",
    "build": "vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
    "typecheck:watch": "tsc --noEmit --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:fast": "pnpm typecheck && pnpm test",
    "dev:fresh": "rm -rf node_modules/.vite node_modules/.vite-temp && pnpm dev:all",
    "lint": "pnpm check:lint",
    "lint:errors": "node scripts/check-bare-catch.mjs",
    "lint:boundaries": "node scripts/check-plugin-render-boundary.mjs",
    "lint:api-contract": "node scripts/check-api-contract.mjs",
    "lint:fix": "biome lint . --write",
    "knip": "knip",
    "check:types": "pnpm typecheck && pnpm typecheck:server",
    "check:lint": "pnpm lint:errors && pnpm lint:boundaries && pnpm lint:api-contract && biome lint .",
    "check:staged-lint": "biome lint",
    "check:unused": "pnpm knip",
    "check:unit": "vitest run",
    "check:pnpm-version": "node scripts/check-package-manager-version.mjs",
    "check:static": "pnpm check:lint && pnpm check:types && pnpm check:unused",
    "check:local": "pnpm check:static && pnpm test && pnpm build",
    "check:pre-push": "pnpm check:types && pnpm lint:errors && pnpm lint:boundaries",
    "check:merge": "pnpm check:static && pnpm check:unit",
    "issue": "node scripts/issue.mjs",
    "merge-task": "node scripts/merge-task.mjs",
    "jupiter:deploy": "node scripts/jupiter-release.mjs deploy",
    "jupiter:verify": "node scripts/jupiter-release.mjs verify",
    "jupiter:release": "node scripts/jupiter-release.mjs release",
    "jupiter:host-doctor": "node scripts/jupiter-release.mjs host-doctor",
    "jupiter:e2e": "node scripts/jupiter-e2e.mjs",
    "jupiter:preview": "node scripts/jupiter-preview.mjs",
    "infra:issue": "node scripts/infra-issue.mjs",
    "smoke": "playwright test --config playwright.smoke.config.ts --grep @smoke-basic",
    "smoke:list": "node scripts/smoke-list.mjs",
    "smoke:issues": "playwright test --config playwright.smoke.config.ts --grep @smoke-issues",
    "smoke:rendering": "playwright test --config playwright.smoke.config.ts --grep @smoke-rendering",
    "smoke:reader-parity": "playwright test --config playwright.smoke.config.ts --grep @smoke-reader-parity",
    "smoke:edit": "playwright test --config playwright.smoke.config.ts --grep @smoke-edit",
    "smoke:api": "node scripts/api-smoke.mjs",
    "test:e2e": "playwright test",
    "check:e2e": "playwright test",
    "check:web": "playwright test tests/e2e/web-pages.spec.ts",
    "check:web:settings": "playwright test tests/e2e/web-settings.spec.ts",
    "check:stability": "pnpm test && pnpm check:e2e",
    "clean": "rm -rf dist",
    "prepare": "lefthook install",
    "setup:dev:manual": "pnpm setup:dev:review && tsx server/cli.ts user create bob Cosheaf123! && tsx server/cli.ts workspace member flushing-coin bob read && tsx server/cli.ts seed --user chao --password Cosheaf123! --workspace passthrough-demo --workspace-name \"Passthrough Demo\" --default-md-format forgejo-passthrough && tsx server/cli.ts workspace member passthrough-demo vera write && tsx server/cli.ts workspace member passthrough-demo meri write && tsx server/cli.ts workspace member passthrough-demo bob read && node scripts/manual-seed-checklist.mjs"
  },
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "lefthook"
    ]
  },
  "dependencies": {
    "@chaoxu/coflat-editor": "0.2.2",
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.2",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.40.0",
    "@hono/node-server": "^2.0.2",
    "@lezer/common": "^1.5.1",
    "@lezer/highlight": "^1.2.3",
    "better-sqlite3": "^12.9.0",
    "commander": "^14.0.3",
    "dompurify": "^3.4.3",
    "hono": "^4.12.18",
    "katex": "^0.16.38",
    "parse-diff": "^0.12.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "knip": "^6.12.2",
    "lefthook": "^2.1.4",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.9",
    "vitest": "^4.1.0"
  }
}
