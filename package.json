{
  "name": "cosheaf",
  "version": "0.1.0",
  "description": "Notion-like multi-user knowledge base for mathematical writing",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev.mjs",
    "dev:worktree": "node scripts/dev-worktree.mjs",
    "setup:dev": "tsx server/cli.ts seed --user chao --password 123123 --workspace flushing-coin --workspace-name \"Flushing Coin\"",
    "setup:dev:review": "pnpm setup:dev && tsx server/cli.ts user create vera 123123 && tsx server/cli.ts user create meri 123123 && tsx server/cli.ts workspace member flushing-coin vera verifier && tsx server/cli.ts workspace member flushing-coin meri member",
    "server": "tsx watch server/index.ts",
    "server:start": "tsx server/index.ts",
    "cli": "tsx server/cli.ts",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
    "typecheck:watch": "tsc --noEmit --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm check:lint",
    "lint:errors": "node scripts/check-bare-catch.mjs",
    "lint:boundaries": "node scripts/check-plugin-render-boundary.mjs",
    "lint:fix": "biome lint . --write",
    "knip": "knip",
    "check:types": "pnpm typecheck && pnpm typecheck:server",
    "check:lint": "pnpm lint:errors && pnpm lint:boundaries && biome lint .",
    "check:staged-lint": "biome lint",
    "check:unused": "pnpm knip",
    "check:unit": "vitest run",
    "check:pnpm-version": "node scripts/check-package-manager-version.mjs",
    "check:static": "pnpm check:lint && pnpm check:types && pnpm check:unused",
    "check:pre-push": "pnpm check:types && pnpm lint:errors && pnpm lint:boundaries",
    "check:merge": "pnpm check:static && pnpm check:unit",
    "issue": "node scripts/issue.mjs",
    "merge-task": "node scripts/merge-task.mjs",
    "smoke": "node scripts/browser-smoke.mjs",
    "smoke:flow": "node scripts/browser-flow.mjs",
    "smoke:review": "node scripts/browser-flow-review.mjs",
    "test:e2e": "playwright test",
    "check:stability": "pnpm test && pnpm smoke && pnpm smoke:flow && pnpm smoke:review && pnpm test:e2e",
    "clean": "rm -rf dist",
    "prepare": "lefthook install"
  },
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@node-rs/argon2",
      "better-sqlite3",
      "esbuild",
      "lefthook"
    ]
  },
  "dependencies": {
    "@chaoxu/coflat-editor": "file:/Users/chaoxu/playground/coflat-editor",
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.2",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.40.0",
    "@hono/node-server": "^2.0.2",
    "@lezer/common": "^1.5.1",
    "@lezer/highlight": "^1.2.3",
    "@node-rs/argon2": "^2.0.2",
    "@radix-ui/react-slot": "^1.2.4",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^14.0.3",
    "hono": "^4.12.18",
    "parse-diff": "^0.12.0",
    "react": "^19.2.4",
    "react-diff-view": "^3.3.3",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "knip": "^6.12.2",
    "lefthook": "^2.1.4",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.9",
    "vitest": "^4.1.0"
  }
}
