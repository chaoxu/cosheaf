# Copy to .env.prod, .env.staging, or .env.testing on jupiter.
# Do not commit real tokens or webhook secrets.

COSHEAF_FORGEJO_TOKEN=
COSHEAF_WEBHOOK_SECRET=

# Point this at the Forgejo service reachable from the Cosheaf container.
# If Forgejo is another container on the same Docker network, this will usually
# look like http://forgejo:3000.
COSHEAF_FORGEJO_URL=http://forgejo:3000
COSHEAF_FORGEJO_OWNER=cosheaf-admin

# Public URLs for this environment. Forgejo should send webhooks to the
# webhook URL, and browser/API clients should reach the server URL.
COSHEAF_SERVER_URL=https://cosheaf.example.com
COSHEAF_WEBHOOK_URL=https://cosheaf.example.com/api/v1/webhooks/forgejo
